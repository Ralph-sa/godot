/**
 * AutoTestMode.ets - Headless smoke-test support
 *
 * The editor normally opens ProjectSelector and waits for the user to pick or
 * create a project. Automated smoke tests cannot answer that prompt, so the
 * launcher may request an unattended run:
 *
 *   aa start -a EntryAbility -b com.godotengine.editor --ps godotAutoTest true
 *
 * EntryAbility reads the want parameter into this singleton during onCreate;
 * GodotEditorPage then bypasses the selector and boots straight into a
 * throwaway sandbox project. Without the parameter every code path here stays
 * inert, so the interactive flow is unchanged.
 */

import { fileIo } from '@kit.CoreFileKit';
import { hilog } from '@kit.PerformanceAnalysisKit';

const TAG = 'AutoTestMode';
const DOMAIN = 0x0000;

/** Want parameter key that switches the app into unattended mode. */
export const AUTO_TEST_PARAM_KEY: string = 'godotAutoTest';

/** Want parameter key that overrides the project name used for the test run. */
export const AUTO_TEST_PROJECT_PARAM_KEY: string = 'godotAutoTestProject';

const DEFAULT_TEST_PROJECT: string = 'SmokeTestProject';

export class AutoTestMode {
  private static enabled: boolean = false;
  private static projectName: string = DEFAULT_TEST_PROJECT;

  /**
   * Records the launch parameters. Accepts the raw want values, which arrive
   * as strings via `--ps` but may be booleans when launched programmatically.
   */
  static configure(enabledValue: string | boolean | undefined,
                   projectValue: string | undefined): void {
    if (typeof enabledValue === 'boolean') {
      AutoTestMode.enabled = enabledValue;
    } else if (typeof enabledValue === 'string') {
      let normalized: string = enabledValue.trim().toLowerCase();
      AutoTestMode.enabled = normalized === 'true' || normalized === '1';
    } else {
      AutoTestMode.enabled = false;
    }

    if (typeof projectValue === 'string' && projectValue.trim().length > 0) {
      AutoTestMode.projectName = projectValue.trim();
    }

    hilog.info(DOMAIN, TAG,
      `Auto-test mode ${AutoTestMode.enabled ? 'ENABLED' : 'disabled'}, project: ${AutoTestMode.projectName}`);
  }

  static isEnabled(): boolean {
    return AutoTestMode.enabled;
  }

  /**
   * Ensures a minimal Godot project exists inside the app sandbox and returns
   * its path. Reuses the directory across runs so repeated smoke tests do not
   * accumulate throwaway projects. Returns an empty string on failure.
   */
  static ensureTestProject(filesDir: string): string {
    let projectsDir: string = filesDir + '/projects';
    let projectDir: string = projectsDir + '/' + AutoTestMode.projectName;
    let projectFile: string = projectDir + '/project.godot';

    try {
      if (!fileIo.accessSync(projectsDir)) {
        fileIo.mkdirSync(projectsDir, true);
      }
      if (!fileIo.accessSync(projectDir)) {
        fileIo.mkdirSync(projectDir, true);
      }

      if (fileIo.accessSync(projectFile)) {
        hilog.info(DOMAIN, TAG, `Reusing existing test project: ${projectDir}`);
        return projectDir;
      }

      let projectConfig: string =
        '; Generated by AutoTestMode for automated smoke testing.\n' +
        '\n' +
        'config_version=5\n' +
        '\n' +
        '[application]\n' +
        '\n' +
        'config/name="' + AutoTestMode.projectName + '"\n';

      let file = fileIo.openSync(projectFile, fileIo.OpenMode.CREATE |
        fileIo.OpenMode.WRITE_ONLY | fileIo.OpenMode.TRUNC);
      fileIo.writeSync(file.fd, projectConfig);
      fileIo.closeSync(file);

      hilog.info(DOMAIN, TAG, `Created test project: ${projectDir}`);
      return projectDir;
    } catch (e) {
      hilog.error(DOMAIN, TAG, `Failed to prepare test project: ${e}`);
      return '';
    }
  }
}
