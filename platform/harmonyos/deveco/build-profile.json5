{
  "app": {
    // AGC HarmonyOS material is injected by hvigorfile.ts from signing.local.json.
    // OpenHarmony local material is applied after unsigned HAP packaging.
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "bundleName": "com.godotengine.editor",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.1.1(24)",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": false
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
