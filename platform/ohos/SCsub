#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
SCsub —— Godot HarmonyOS 平台编译清单

功能：声明平台源文件列表，产出静态库 libgodot.ohos.editor（供 DevEco CMake 链接）
或共享库 / 可执行程序（headless 测试用）。

第 1 轮（骨架期）：OS 层 + 窗口宿主 + DisplayServer + 渲染驱动 + 输入 + 系统集成。
"""
from misc.utility.scons_hints import *

import platform_ohos_builders

Import("env")

# 平台源码文件清单（第 1 轮骨架期；第 6 轮追加音频驱动）
files = [
    # OS 层：路径 + 生命周期
    "os_ohos.cpp",
    # 窗口宿主：XComponent + 窗口抽象
    "ohos_xcomponent.cpp",
    "ohos_window.cpp",
    # DisplayServer：窗口 + 渲染启用
    "display_server_ohos.cpp",
    # 渲染驱动：Vulkan Surface（VK_OHOS_surface）
    "rendering_context_driver_vulkan_ohos.cpp",
    # 输入：键位映射
    "key_mapping_ohos.cpp",
    # 系统集成：崩溃处理器
    "crash_handler_ohos.cpp",
    # 音频：OHAudio 渲染流驱动（第 6 轮）
    "audio_driver_ohos.cpp",
    # 输入法：inputmethod C API 中文输入（第 8 轮）
    "ime_ohos.cpp",
]

if env.editor_build:
    # 编辑器构建：导出器插件（后续轮次追加嵌入式窗口等）
    files += [
        "export/export.cpp",
        "export/export_plugin.cpp",
    ]

# NAPI 入口：OHOS 无 main，应用由 ArkTS UIAbility 驱动。
# 共享库/可执行程序都需编入 NAPI 模块注册（DevEco 工程加载 libgodot.so）。
if env["library_type"] == "shared_library" or env["library_type"] == "executable":
    files += ["main_ohos.cpp"]

if env["library_type"] == "static_library":
    # 静态库产物：供 DevEco 工程 CMake 链接（libgodot.ohos.editor.arm64.a）
    prog = env.add_library("#bin/godot", files)
elif env["library_type"] == "shared_library":
    # 共享库产物：libgodot.so（NAPI 模块，DevEco 工程使用）
    prog = env.add_shared_library("#bin/godot", files)
else:
    # 可执行程序
    prog = env.add_program("#bin/godot", files)

if env["debug_symbols"] and env["separate_debug_symbols"]:
    env.AddPostAction(prog, env.Run(platform_ohos_builders.make_debug_ohos))
